<idea-plugin>
    <id>com.anchor.commentdoclinks</id>
    <name>Comment Doc Links</name>
    <vendor url="https://github.com/anchor-os/commentDocLinksExtension" email="">getanchor.io</vendor>

    <icon>pluginIcon.svg</icon>

    <description><![CDATA[
        Navigate between source comments and markdown documentation with two-way links.
        (getanchor.io)
    ]]></description>

    <!-- Compatibility with WebStorm and other IntelliJ-based IDEs. -->
    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <psi.referenceContributor
            implementation="com.anchor.commentdoclinks.navigation.CommentDocReferenceContributor"/>

        <psi.referenceContributor
            implementation="com.anchor.commentdoclinks.navigation.MarkdownSourceLinkContributor"/>

        <completion.contributor
            implementationClass="com.anchor.commentdoclinks.completion.ReferenceCompletionContributor"/>

        <annotator
            language="ANY"
            implementationClass="com.anchor.commentdoclinks.decorations.CommentDocLinkAnnotator"/>

        <localInspection
            language="JavaScript"
            shortName="CustomBiomeLint"
            displayName="Custom Biome Lint"
            groupPath="Comment Doc Links"
            groupName="Comment Doc Links"
            enabledByDefault="true"
            level="WARNING"
            implementationClass="com.anchor.commentdoclinks.lint.CustomBiomeLintInspection"/>

        <applicationConfigurable
            instance="com.anchor.commentdoclinks.config.CommentDocLinksConfigurable"
            displayName="Comment Doc Links"
            id="com.anchor.commentdoclinks.settings"/>
    </extensions>
</idea-plugin>