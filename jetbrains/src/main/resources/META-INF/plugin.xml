<idea-plugin>
    <id>com.anchor.commentdoclinks</id>
    <name>Comment Doc Links</name>
    <vendor url="https://github.com/anchor-os/commentDocLinksExtension" email="">getanchor.io</vendor>

    <icon>pluginIcon.svg</icon>

    <description><![CDATA[
        Navigate between source comments and markdown documentation with two-way links.
        (getanchor.io)
    ]]></description>

    <change-notes><![CDATA[
        <p><strong>0.1.20</strong> &mdash; custom-biome-lint v1 contract</p>
        <ul>
            <li>Both VS Code and JetBrains adapters now consume the custom-biome-lint v1 JSON contract (envelope + summary).</li>
            <li>Correct UTF-8 byte &rarr; UTF-16 column conversion so diagnostics and quick-fix edits land on the right characters, including emoji/astral characters.</li>
            <li>Stdin linting and the rule catalog are supported; multiple safe fixes and suppressions per violation are offered.</li>
            <li>Full changelog: <a href="https://github.com/anchor-os/commentDocLinksExtension/blob/main/CHANGELOG.md">CHANGELOG.md</a></li>
        </ul>
    ]]></change-notes>

    <!-- Compatibility with WebStorm and other IntelliJ-based IDEs. -->
    <depends>com.intellij.modules.platform</depends>

    <!-- The custom-biome-lint inspection only applies to JavaScript/JSX, so it
         is registered only when the JavaScript plugin is present. -->
    <depends optional="true" config-file="withJavaScript.xml">com.intellij.javascript</depends>

    <extensions defaultExtensionNs="com.intellij">
        <psi.referenceContributor
            implementation="com.anchor.commentdoclinks.navigation.CommentDocReferenceContributor"/>

        <psi.referenceContributor
            implementation="com.anchor.commentdoclinks.navigation.MarkdownSourceLinkContributor"/>

        <completion.contributor
            implementationClass="com.anchor.commentdoclinks.completion.ReferenceCompletionContributor"/>

        <annotator
            implementationClass="com.anchor.commentdoclinks.decorations.CommentDocLinkAnnotator"/>

        <applicationConfigurable
            instance="com.anchor.commentdoclinks.config.CommentDocLinksConfigurable"
            displayName="Comment Doc Links"
            id="com.anchor.commentdoclinks.settings"/>
    </extensions>
</idea-plugin>