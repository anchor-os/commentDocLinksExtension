{
  "contractVersion": 1,
  "binary": "custom-biome-lint",
  "invocation": "custom-biome-lint --stdin <virtualPath> --format json   (feed file contents on stdin)",
  "coordinateModel": {
    "contract": "1-based line + 1-based BYTE offset (UTF-8) in 'files[].violations[]' (startLine/startColumn/endLine/endColumn, plus convenience line/col).",
    "editor": "Editors index by UTF-16 code units. IntelliJ char offset and VS Code Position.character are BOTH UTF-16 code-unit indices, so a single byte->utf16 conversion applies to both adapters (only the API differs).",
    "edits": "fixes[]/suppressions[] edits use the same byte-coordinate model and MUST be converted before applying to editor text."
  },
